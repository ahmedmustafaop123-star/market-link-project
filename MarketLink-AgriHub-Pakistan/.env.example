# MarketLink Agri-Hub Pakistan: settings
#
# DATABASE
#   Leave DATABASE_URL empty to use the BUILT-IN database (no installation needed).
#   Data is stored in the ".data" folder next to this file.
#
#   To use PostgreSQL installed on this laptop (pgAdmin can inspect the tables),
#   replace the blank DATABASE_URL below with the connection string below.
#   Use the PostgreSQL password you chose during installation (NOT password123,
#   which is only the website's demo login password):
#   DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/app_db
#   URL-encode password characters such as @, #, /, : and ? if they appear.
#   The app can create app_db automatically when the postgres user has permission.
#   Test it with: node scripts/check-db.cjs --create
DATABASE_URL=

# ADMIN LOGIN (applied on the FIRST start, when the database is created).
#   Leave empty to use the default Super Admin: Ahmed Mustafa · ahmed.mustafa@admin.com / password123
#   After that, change the password in the app: Account settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Any long random text, used to sign login cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "true" only when the site is served over HTTPS (cloud hosting).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# PUBLIC URL (used in payment return URLs and email links)
APP_URL=http://localhost:3000

# PAYMENTS: wallet top-ups are credited only by verified gateway callbacks.
PAYMENTS_MODE=sandbox            # sandbox | live (JazzCash/Easypaisa endpoints)
PAYMENTS_SANDBOX=true            # built-in test gateway; set false in production
STRIPE_SECRET_KEY=               # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=           # whsec_…  endpoint: /api/payments/webhook/stripe
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=              # for server-to-server transaction inquiry
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=

# NOTIFICATIONS: without keys, emails/SMS are written to the server log (outbox)
RESEND_API_KEY=                  # email (resend.com)
EMAIL_FROM=MarketLink <noreply@yourdomain.pk>
TWILIO_ACCOUNT_SID=              # SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI ASSISTANT: one of these enables the LLM (bilingual English / Roman Urdu)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# GOOGLE SIGN-IN (OAuth 2.0): create credentials at console.cloud.google.com → APIs & Services → Credentials
#   On your laptop, use http://localhost:3000/api/auth/google/callback as the
#   Authorized redirect URI; for hosting, replace localhost with your site's URL.
#   The URI in Google Cloud must exactly match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_MOCK=true           # test-mode chooser while Google keys are missing; set false in production

# PASSWORD RESET: without an email provider, reset links for non-staff accounts are shown on screen.
AUTH_DEV_LINKS=true              # set false (or configure RESEND_API_KEY) before real users sign up
